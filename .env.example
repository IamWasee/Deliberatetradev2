# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are safe in the browser: the anon key is public by design and
# is constrained by Row Level Security policies on the database.
#
# NEVER put the service_role key here or anywhere in this repo — it bypasses
# RLS entirely and would expose every user's data.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
